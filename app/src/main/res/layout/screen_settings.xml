<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/preferences" android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"/><TextView android:id="@+id/preferences_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/preferences" android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"/><TextView android:id="@+id/language_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/app_language" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
<RadioGroup android:id="@+id/languages" android:layout_width="match_parent" android:layout_height="wrap_content">
<RadioButton android:id="@+id/language_en" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/language_en_label"/>
<RadioButton android:id="@+id/language_ve" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/language_ve_label"/>
<RadioButton android:id="@+id/language_zu" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/language_zu_label"/>
</RadioGroup>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/dark" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/dark_mode"/>
<TextView android:id="@+id/currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/currency_zar" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/notifications" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/notifications"/>
<TextView android:id="@+id/threshold_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/notifications" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
<SeekBar android:id="@+id/threshold" android:layout_width="match_parent" android:layout_height="48dp" android:min="50" android:max="100" android:contentDescription="@string/budget_alert"/>
<TextView android:id="@+id/sync_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/cloud_sync" android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"/><TextView android:id="@+id/sync_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/account_sync_notice" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/><TextView android:id="@+id/pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/cloud_sync" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/sync_ready" android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/sync_now" /><com.google.android.material.button.MaterialButton android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/logout" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/></LinearLayout></androidx.core.widget.NestedScrollView>
