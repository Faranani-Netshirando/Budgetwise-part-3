<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/category" android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"/><TextView android:id="@+id/value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/amount" android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"/><TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/description" android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"/>
<ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:visibility="gone"/>
<TextView android:id="@+id/warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorError" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.button.MaterialButton android:id="@+id/receipt" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/view_receipt" style="@style/Widget.MaterialComponents.Button.TextButton" android:visibility="gone"/>
<LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/edit"/>
<com.google.android.material.button.MaterialButton android:id="@+id/delete" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/delete"/>
</LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
